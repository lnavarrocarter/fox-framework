{
  "name": "@foxframework/auth-jwt",
  "version": "1.0.0",
  "description": "JWT authentication provider for Fox Framework — JwtAuthProvider, InMemoryUserStore, TokenService",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
