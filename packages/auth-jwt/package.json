    "bcrypt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@foxframework/core": "*",
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "bcrypt": "^5.1.0",
    "jest": "^29.0.0",
    "jsonwebtoken": "^9.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lnavarrocarter/fox-framework.git",
    "directory": "packages/auth-jwt"
  },
  "bugs": {
    "url": "https://github.com/lnavarrocarter/fox-framework/issues"
