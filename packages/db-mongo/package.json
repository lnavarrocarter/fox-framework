{
  "name": "@foxframework/db-mongo",
  "version": "1.0.0",
  "description": "MongoDB provider for Fox Framework — Repository pattern via mongodb driver",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/**/*", "README.md", "LICENSE", "package.json"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.build.json", "test": "jest", "test:coverage": "jest --coverage" },
  "keywords": ["fox-framework", "mongodb", "repository-pattern", "typescript"],
  "peerDependencies": { "@foxframework/core": ">=1.0.0", "mongodb": ">=6.0.0" },
  "peerDependenciesMeta": { "mongodb": { "optional": false } },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "mongodb": "^6.12.0",
    "@foxframework/core": "*"
  }
}
