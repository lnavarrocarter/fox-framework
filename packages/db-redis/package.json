{
  "name": "@foxframework/db-redis",
  "version": "1.0.0",
  "description": "Redis provider for Fox Framework — strings, hashes, lists, sets, counters and JSON helpers via ioredis",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist/**/*", "README.md", "LICENSE", "package.json"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "jest", "test:coverage": "jest --coverage" },
  "keywords": ["fox-framework", "redis", "ioredis", "cache", "typescript"],
  "peerDependencies": { "@foxframework/core": ">=1.0.0", "ioredis": ">=5.0.0" },
  "peerDependenciesMeta": { "ioredis": { "optional": false } },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "ioredis": "^5.3.0",
    "@foxframework/core": "*"
  }
