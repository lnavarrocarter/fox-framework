{
  "name": "@foxframework/cli",
  "version": "1.4.0",
  "description": "Fox Framework CLI — scaffold, generate, deploy and manage Fox projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tsfox": "dist/bin.js"
  },
  "files": ["dist/**/*", "package.json"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --config jest.config.ts --detectOpenHandles --forceExit",
    "prepare": "npm run build"
  },
  "keywords": ["fox-framework", "cli", "scaffolding", "generator"],
  "author": "Luis Navarro Carter",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "inquirer": "^9.2.0",
    "ora": "^7.0.0",
    "chalk": "^5.3.0"
  },
  "peerDependencies": {
    "@foxframework/core": "*"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2"
  }
}
